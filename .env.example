# Copy to .env and fill in values:
#   cp .env.example .env
#
# Required for local paper trading (matches mystic-Virtual-Machine defaults).

# --- Core paths ---
DATABASE_URL=sqlite:////home/mystic/mystic/mystic_trading.db
REDIS_URL=redis://127.0.0.1:6379/0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Trading mode (paper default) ---
PAPER_TRADING=true
PAPER_TRADING_INITIAL_BALANCE=10000.0
LIVE_TRADES_ALLOWED=false
EXTERNAL_SUPERVISOR_MODE=true

# --- Exchange (Binance US read-only for market data; paper execution) ---
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=
DISPLAY_EXCHANGE=binanceus

# --- Admin / API auth (generate random strings) ---
ADMIN_API_KEY=change-me-admin-api-key
ADMIN_TOKEN=change-me-admin-token
JWT_SECRET=change-me-jwt-secret

# --- Optional integrations (leave empty to disable) ---
DISCORD_WEBHOOK=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
ENABLE_DISCORD=false

# --- AI / learning ---
AI_TRAINING_ENABLED=true
AI_MODEL_LAZY_LOAD=true
FEATURE_VERSION_DAY_HTF=5

# --- Binance.US scalp scaffold (Phase 1 — all disabled) ---
SCALP_PAPER_ENABLED=false
SCALP_LIVE=false
# Entry arming via Redis scalp:control:entry_armed (runtime; not .env). Paper can run warm disarmed.
SCALP_FEE_MODEL_VERIFIED=false
SCALP_PRODUCTS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT
SCALP_MAX_OPEN_POSITIONS=1
SCALP_MAX_NOTIONAL_PAPER=50
SCALP_REJECT_LOG_INTERVAL_SEC=300
SCALP_STATUS_CACHE_TTL_SEC=20
SCALP_ALLOW_REPAIR_ADD=false
SCALP_ALLOW_MARKET_ORDERS=false
SCALP_REDIS_PREFIX=scalp
SCALP_MAKER_FEE_PCT=0.0
SCALP_TAKER_FEE_PCT=0.0002
SCALP_MIN_NET_EDGE_PCT=0.0015
SCALP_NET_PROFIT_TARGET_PCT=0.0025
SCALP_STALE_TIMEOUT_SEC=300
SCALP_SLIPPAGE_BUFFER_PCT=0.0001
SCALP_SPREAD_CAP_PCT=0.0005
SCALP_IMPACT_CAP_PCT=0.0005
SCALP_LOOP_SEC=5
# Comma-separated strategy names to skip (replay showed orderbook_tape_scalp net-negative)
SCALP_DISABLED_STRATEGIES=orderbook_tape_scalp,range_bounce_scalp,vwap_ema_reclaim
SCALP_CALIBRATION_MODE=false
SCALP_CALIBRATION_PROFILE=moderate

# --- DAY optional entry quality gates (default OFF — telemetry only) ---
# DAY_REQUIRE_SETUP_CREDIT=false
# DAY_ENTRY_RS_FLOOR=
# DAY_ENTRY_RS_RANK_MAX=
# DAY_SETUP_RS_RANK_MAX=2
# DAY_PAPER_ALIGN_SPREAD_WITH_BAR=false

# --- Local stack profile (also see deploy/core_only_local.env) ---
CORE_ONLY_MODE=true
AI_CANONICAL_EXECUTION_ONLY=true
