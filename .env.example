# Copy to .env and fill in values:
#   cp .env.example .env
#
# Required for local paper trading (matches mystic-Virtual-Machine defaults).

# --- Core paths ---
DATABASE_URL=sqlite:////home/mystic/mystic/mystic_trading.db
REDIS_URL=redis://127.0.0.1:6379/0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Trading mode (paper default) ---
PAPER_TRADING=true
PAPER_TRADING_INITIAL_BALANCE=10000.0
LIVE_TRADES_ALLOWED=false
EXTERNAL_SUPERVISOR_MODE=true

# --- Exchange (Binance US read-only for market data; paper execution) ---
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=
DISPLAY_EXCHANGE=binanceus

# --- Admin / API auth (generate random strings) ---
ADMIN_API_KEY=change-me-admin-api-key
ADMIN_TOKEN=change-me-admin-token
JWT_SECRET=change-me-jwt-secret

# --- Optional integrations (leave empty to disable) ---
DISCORD_WEBHOOK=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
ENABLE_DISCORD=false

# --- AI / learning ---
AI_TRAINING_ENABLED=true
AI_MODEL_LAZY_LOAD=true
FEATURE_VERSION_DAY_HTF=5

# --- Local stack profile (also see deploy/core_only_local.env) ---
CORE_ONLY_MODE=true
AI_CANONICAL_EXECUTION_ONLY=true
