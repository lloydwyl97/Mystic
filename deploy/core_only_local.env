# Shared paper/core profile sourced by start_mystic.sh when present (local + Ocean).
# CORE_ONLY_MODE keeps phase-1 defaults from backend/config/core_test_flags.py for unset ENABLE_*.
# Explicit ENABLE_* below override those defaults so decorative-safety wiring actually enforces.
CORE_ONLY_MODE=true
AI_CANONICAL_EXECUTION_ONLY=true

# Bar/signal consumer timing only (not a risk bypass).
PORTFOLIO_LOCAL_BAR_SIGNAL_GRACE_SEC=6

# Governance + pacing (wired into PortfolioEngine buy path).
ENABLE_GOVERNANCE_ENFORCEMENT=true
GOVERNANCE_SHADOW_ONLY=false
ENABLE_COOLDOWN_ENFORCEMENT=true

# Previously PE used getenv default=true for these; core_test_flags when_core=False
# would have silently disabled them under CORE_ONLY_MODE — keep them on.
ENABLE_REGIME_ENFORCEMENT=true
ENABLE_QUARANTINE_ENFORCEMENT=true
ENABLE_ATR_ENFORCEMENT=true
ENABLE_PROFITABILITY_ENFORCEMENT=true
ENABLE_TRADE_STATE_ENTRY_BLOCKING=true
ENABLE_SLEEVE_BLOCKING=false

# Do not skip consec-loss hold — that made HOLD_CONSEC_LOSSES decorative again.
GOVERNANCE_LOCAL_SKIP_HOLD_CONSEC_LOSSES=false
