# Minimal local staged-testing profile (after paper reset).
# No PORTFOLIO_LOCAL_SKIP_* / GOVERNANCE_LOCAL_SKIP_* — avoids distorting production gates on paper.
# CORE_ONLY_MODE keeps phase-1 defaults from backend/config/core_test_flags.py for unset ENABLE_*.
CORE_ONLY_MODE=true
AI_CANONICAL_EXECUTION_ONLY=true

# Bar/signal consumer timing only (not a risk bypass).
PORTFOLIO_LOCAL_BAR_SIGNAL_GRACE_SEC=6

# Meaningful governance + pacing on paper (explicit; core-only defaults would leave some off).
ENABLE_GOVERNANCE_ENFORCEMENT=true
GOVERNANCE_SHADOW_ONLY=false
ENABLE_COOLDOWN_ENFORCEMENT=true

# Local staged testing only: HOLD_CONSEC_LOSSES telemetry only (does not return Layer1 hold).
GOVERNANCE_LOCAL_SKIP_HOLD_CONSEC_LOSSES=true
