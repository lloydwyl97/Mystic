# Shared paper/core profile sourced by start_mystic.sh when present (local + Ocean).
# CORE_ONLY_MODE keeps phase-1 defaults from backend/config/core_test_flags.py for unset ENABLE_*.
# Explicit ENABLE_* below override those defaults so decorative-safety wiring actually enforces.
CORE_ONLY_MODE=true
AI_CANONICAL_EXECUTION_ONLY=true

# Bar/signal consumer timing only (not a risk bypass).
PORTFOLIO_LOCAL_BAR_SIGNAL_GRACE_SEC=6

# Governance + pacing (wired into PortfolioEngine buy path).
ENABLE_GOVERNANCE_ENFORCEMENT=true
GOVERNANCE_SHADOW_ONLY=false
ENABLE_COOLDOWN_ENFORCEMENT=true

# Previously PE used getenv default=true for these; core_test_flags when_core=False
# would have silently disabled them under CORE_ONLY_MODE — keep them on.
ENABLE_REGIME_ENFORCEMENT=true
ENABLE_QUARANTINE_ENFORCEMENT=true
ENABLE_ATR_ENFORCEMENT=true
ENABLE_PROFITABILITY_ENFORCEMENT=true
ENABLE_TRADE_STATE_ENTRY_BLOCKING=true
# Sleeve blocking stays off on purpose: CORE/ACTIVE sleeve limits are telemetry /
# sizing hints only until sleeve policy is re-validated on paper.
ENABLE_SLEEVE_BLOCKING=false

# Do not skip consec-loss hold — that made HOLD_CONSEC_LOSSES decorative again.
GOVERNANCE_LOCAL_SKIP_HOLD_CONSEC_LOSSES=false

# Refresh equal-quality models after this many hours so DAY RF keeps absorbing
# recent coin/market structure instead of freezing on a tied active artifact.
MODEL_STALE_HOURS=36

# Ocean ETH often lands ~90–95 rows after buy-rate balancing with empty Tier B/C.
# Keep quality caps; allow train slightly under the old hard 100 floor.
MIN_RF_TRAIN_SAMPLES=90
MIN_RF_TIER_A_ROWS=40

# Drain pending candidate snapshot labels faster (was hardcoded 400).
AI_SNAPSHOT_LABEL_BATCH_LIMIT=1000

# --- DAY admission tune (overrides stricter .env 0.08/0.12) ---
# Require real BUY separation, but don't demand CORE-tier edges for paper learning.
# buy_margin = P_buy - max(P_hold, P_sell); still blocks all-HOLD (negative margin).
# 0.03 was starving ETH (often ~0.029); keep positive floor so HOLD stays out.
BUY_MARGIN_THRESHOLD_ACTIVE=0.02
BUY_MARGIN_THRESHOLD_CORE=0.06
BAR_EXEC_ABSOLUTE_MIN_BUY_MARGIN=0.005
MIN_CONFIDENCE=0.58
# Governance must allow multi-slot fills (DAY_MAX_BUYS_PER_BAR); default was 2.
MAX_TRADES_PER_BAR=4
DAY_MAX_BUYS_PER_BAR=4
DAY_TARGET_NOTIONAL_PER_SLOT_USD=2200
DAY_BASE_NOTIONAL_PER_SLOT_USD=2000
DAY_MAX_DEPLOYED_USD=9000
DAY_AW_OWNER_ENABLED=false
ALLWEATHER_BREAKOUT_PULLBACK_ENABLED=false
DAY_STALL_RISK_HARD_GATE_ENABLED=false

# --- DAY stall (2026-07-25 retune; adverse floor corrected 2026-08-01) ---
# 30-day data showed TIME_STOP + STALL exits combined cost -$2,107 while
# proper NET_PROFIT/TRAILING exits made +$2,428 — the clock was cutting
# positions before they resolved. Raised min-hold 45->120m and MFE
# threshold 0.15%->0.50% to match the day_controlled_exits.py code
# defaults (this file was silently overriding them via source-order in
# start_mystic.sh).
DAY_STALL_MIN_HOLD_MIN=120
# DAY STALL adverse floor. Read by day_controlled_exits.py.
# 0.0025 = 0.25% MAE required before STALL may force a red dead-trade exit.
DAY_STALL_MIN_ADVERSE_PCT=0.0025
DAY_STALL_MAX_MFE_PCT=0.0050

# --- SCALP tune: EARLY_SCRATCH was ~all losses (~209s avg); winners ~750s ---
# Delay scratch / reviews so bounce trades can reach NET_PROFIT_TARGET.
SCALP_STALE_TIMEOUT_SEC=300
SCALP_REVIEW_TRIGGER_SEC=300
SCALP_SCRATCH_MIN_HOLD_SEC=540
SCALP_SCRATCH_MIN_REVIEWS=3
SCALP_SCRATCH_PROGRESS_FRAC=0.20
SCALP_RANGE_MIN_WICK_FRAC=0.18
SCALP_RANGE_MIN_MID_CHANGE_60S=0.00005
SCALP_RANGE_SCRATCH_MIN_HOLD_SEC=720
SCALP_RANGE_SCRATCH_MIN_REVIEWS=3
