# Portfolio engine paper-test overrides.
# Source AFTER repo `.env` so these values win (see scripts/start_portfolio_paper_test.sh).
# Use KEY=value only (no "export") so the same file works as systemd EnvironmentFile.
# No secrets — safe to commit.

MYSTIC_CHURN_RATIO_LIMIT=4.5
MYSTIC_SPREAD_SPIKE_THRESHOLD=0.004
MYSTIC_SPREAD_BLOCK_BARS=3
MAX_SPREAD_PCT=0.35

AI_CANONICAL_EXECUTION_ONLY=true
