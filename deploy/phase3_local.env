# Local Phase 3: core + ATR + governance enforcement (source after .env). Do not commit secrets.

CORE_ONLY_MODE=true

ENABLE_GOVERNANCE_ENFORCEMENT=true
ENABLE_COOLDOWN_ENFORCEMENT=false
ENABLE_ATR_ENFORCEMENT=true
ENABLE_PROFITABILITY_ENFORCEMENT=false
ENABLE_REGIME_ENFORCEMENT=false
ENABLE_QUARANTINE_ENFORCEMENT=false
ENABLE_SLEEVE_BLOCKING=false
ENABLE_TRADE_STATE_ENTRY_BLOCKING=false
ENABLE_ALTERNATE_SIGNAL_PATHS=false
ENABLE_OVERFLOW_SIZING=false

AI_CANONICAL_EXECUTION_ONLY=true
