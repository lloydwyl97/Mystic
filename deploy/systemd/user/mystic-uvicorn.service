[Unit]
Description=Mystic API and dashboard (uvicorn :8000)
After=network-online.target
PartOf=mystic.target

[Service]
Type=simple
WorkingDirectory=/home/mystic/mystic
EnvironmentFile=-/home/mystic/mystic/.env
ExecStart=/home/mystic/mystic/venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=mystic.target
