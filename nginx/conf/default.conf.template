# Nginx Configuration Template - Live Configuration Only
#
# This template uses environment variables that must be set from live configuration.
# All configuration values come from live config - no hardcoded values, no fallback data.
#
# IMPORTANT: Environment variables must be set from live configuration before substitution.
# The preferred method is to use the Python generator which reads directly from live config:
#   python scripts/generate_nginx_config.py
#
# Alternative: Use envsubst after setting environment variables from live config:
#   export NGINX_LISTEN_PORT=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().nginx.listen_port)")
#   export NGINX_SERVER_NAME=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().nginx.server_name)")
#   export BACKEND_HOST=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().backend.host)")
#   export BACKEND_PORT=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().backend.port)")
#   export NGINX_PROXY_READ_TIMEOUT=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().nginx.proxy_read_timeout)")
#   export NGINX_PROXY_SEND_TIMEOUT=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().nginx.proxy_send_timeout)")
#   export NGINX_PROXY_CONNECT_TIMEOUT=$(python -c "from backend.config_bridge import get_mystic_config; print(get_mystic_config().nginx.proxy_connect_timeout)")
#   envsubst < nginx/conf/default.conf.template > nginx/conf/default.conf
#
# Required environment variables (must be set from live config, no fallbacks):
#   - NGINX_LISTEN_PORT: Port nginx listens on (e.g., 80, 443)
#   - NGINX_SERVER_NAME: Server name/hostname
#   - BACKEND_HOST: Backend service hostname (e.g., mystic-backend)
#   - BACKEND_PORT: Backend service port (e.g., 8000)
#   - NGINX_PROXY_READ_TIMEOUT: Proxy read timeout (e.g., 86400s)
#   - NGINX_PROXY_SEND_TIMEOUT: Proxy send timeout (e.g., 86400s)
#   - NGINX_PROXY_CONNECT_TIMEOUT: Proxy connect timeout (e.g., 86400s)

server {
    listen ${NGINX_LISTEN_PORT};
    server_name ${NGINX_SERVER_NAME};

    # API routes - proxy to backend
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # Health check - proxy to backend
    location /health {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Dashboard - all routes including WebSocket and static assets
    location / {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_buffering off;
    }
}
