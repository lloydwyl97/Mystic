[Unit]
Description=Mystic AI Market Context
After=network.target mystic-backend.service
Wants=mystic-backend.service

[Service]
Type=simple
User=mystic
Group=mystic
WorkingDirectory=/home/mystic/mystic
Environment=PATH=/home/mystic/mystic/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/mystic/mystic
Environment=AI_CANONICAL_EXECUTION_ONLY=true
EnvironmentFile=/home/mystic/mystic/.env
EnvironmentFile=-/home/mystic/mystic/deploy/core_only_local.env
ExecStart=/home/mystic/mystic/venv/bin/python start_ai_market_context.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
