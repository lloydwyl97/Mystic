[Unit]
Description=Mystic Trading Backend API
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=mystic
Group=mystic
WorkingDirectory=/home/mystic/mystic
Environment=PATH=/home/mystic/mystic/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/mystic/mystic
EnvironmentFile=/home/mystic/mystic/.env
EnvironmentFile=-/home/mystic/mystic/deploy/core_only_local.env
# Same gate + cleanup order as start_mystic.sh (mode=all) before uvicorn binds :8000
ExecStartPre=/bin/bash -lc 'cd /home/mystic/mystic && bash scripts/run_predeploy_checks.sh'
ExecStartPre=/home/mystic/mystic/venv/bin/python /home/mystic/mystic/MANDATORY_CLEANUP.py
ExecStart=/home/mystic/mystic/venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
