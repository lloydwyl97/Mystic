# Example ONLY — do not install/enable until a deliberate cutover window.
# Validates: EnvironmentFile order (.env then paper_test_engine.env) matches
# scripts/start_portfolio_paper_test.sh intent. Run `sshd -t` / `systemd-analyze verify` analog
# checks before enable.
#
# NOTE: start_portfolio_paper_test.sh uses nohup — do NOT use that script as ExecStart
# with Type=simple. Use direct python below (same binary as launcher ends up running).

[Unit]
Description=Mystic Portfolio Engine Integration (paper-test env) — EXAMPLE
After=network-online.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=mystic
Group=mystic
WorkingDirectory=/home/mystic/mystic
EnvironmentFile=-/home/mystic/mystic/.env
EnvironmentFile=-/home/mystic/mystic/deploy/paper_test_engine.env
ExecStart=/home/mystic/mystic/venv/bin/python /home/mystic/mystic/start_portfolio_engine_integration.py
Restart=on-failure
RestartSec=15
StandardOutput=append:/home/mystic/mystic/var/paper_run_audit/active/integration.log
StandardError=append:/home/mystic/mystic/var/paper_run_audit/active/integration.log

[Install]
WantedBy=multi-user.target
